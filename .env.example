# ==============================================================================
# Emby BPM & Tempo Controller Plugin - Deployment Configuration
# Copy this file to .env and configure your local paths:
#   cp .env.example .env
# ==============================================================================

# Target directory on your host where Emby's plugins are stored.
# This should point to the 'plugins' directory inside your Emby config folder.
#
# Examples:
#   Docker host bind mount:
#     EMBY_PLUGINS_DIR=/path/to/emby/config/plugins
#
#   Docker volume on Linux (default docker volume path):
#     EMBY_PLUGINS_DIR=/var/lib/docker/volumes/emby_config/_data/plugins
#
#   Bare-metal / Unraid / Synology / TrueNAS:
#     EMBY_PLUGINS_DIR=/mnt/user/appdata/emby/plugins
#
EMBY_PLUGINS_DIR=

EMBY_CONTAINER_NAME=emby

# Optional: Emby HTTP port on host for running-checks (default: 8096)
EMBY_PORT=8096
