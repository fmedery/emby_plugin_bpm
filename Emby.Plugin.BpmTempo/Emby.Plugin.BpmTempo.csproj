<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Emby.Plugin.BpmTempo</AssemblyName>
    <RootNamespace>Emby.Plugin.BpmTempo</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Frederic</Authors>
    <Company>Emby Community</Company>
    <Product>BPM &amp; Tempo Controller for Emby</Product>
    <Description>Control playback speed/tempo and BPM without altering pitch for Emby music libraries.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.8.11" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\bpm-player.js" />
    <EmbeddedResource Include="Web\bpm-player.css" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>

</Project>
